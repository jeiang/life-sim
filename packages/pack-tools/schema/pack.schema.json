{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "title": "Pack manifest (pack.yaml)",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "namespace": {
      "pattern": "^[a-z][a-z0-9]*$",
      "description": "Id prefix: every stat and quality this Pack declares starts with `<namespace>_`. Unique across Packs; not enforced for core-loop",
      "type": "string"
    },
    "currency": {
      "additionalProperties": false,
      "type": "object",
      "required": ["symbol", "digits"],
      "properties": {
        "symbol": {
          "minLength": 1,
          "type": "string"
        },
        "digits": {
          "minimum": 0,
          "maximum": 4,
          "type": "integer"
        }
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "label", "start"],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "icon": {
            "description": "A literal emoji (Twemoji subset) or `gameicons/<author>/<name>`",
            "type": "string"
          },
          "start": {
            "description": "Inclusive start range within 0-100",
            "type": "array",
            "items": [
              {
                "minimum": 0,
                "maximum": 100,
                "type": "integer"
              },
              {
                "minimum": 0,
                "maximum": 100,
                "type": "integer"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "exclusivity": {
      "type": "array",
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "description": "Content id",
        "type": "string"
      }
    },
    "repeat": {
      "additionalProperties": false,
      "title": "Default diminishing-returns curve for repeatable actions",
      "type": "object",
      "properties": {
        "full": {
          "minimum": 0,
          "description": "Uses per year that give the full effect",
          "type": "integer"
        },
        "reduced": {
          "minimum": 0,
          "description": "Uses per year up to which gains are reduced; later uses give none",
          "type": "integer"
        },
        "factor": {
          "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
          "description": "Share of each gain kept in the reduced range, for example `25%`",
          "type": "string"
        }
      }
    },
    "year": {
      "additionalProperties": false,
      "type": "object",
      "required": ["slots", "cap"],
      "properties": {
        "slots": {
          "description": "Flavour slot count range [min, max]",
          "type": "array",
          "items": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "cap": {
          "minimum": 0,
          "type": "integer"
        },
        "decisions": {
          "minItems": 1,
          "description": "Decision slots: chance of at least 1, 2, 3, ... decisions in a year (non-increasing percents)",
          "type": "array",
          "items": {
            "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
            "description": "Probability of at least this many decisions",
            "type": "string"
          }
        },
        "decisions_min_age": {
          "minimum": 0,
          "description": "Age reached from which decision slots roll",
          "type": "integer"
        },
        "quiet": {
          "minItems": 1,
          "description": "Neutral journal lines for a year with no events; one is picked per quiet year",
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "family": {
      "additionalProperties": false,
      "title": "Starting family",
      "type": "object",
      "required": ["parent", "sibling"],
      "properties": {
        "player": {
          "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
          "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "parent": {
          "additionalProperties": false,
          "type": "object",
          "required": ["role", "generator", "count"],
          "properties": {
            "role": {
              "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
              "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
              "type": "string"
            },
            "generator": {
              "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
              "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
              "type": "string"
            },
            "count": {
              "minimum": 0,
              "type": "integer"
            }
          }
        },
        "sibling": {
          "additionalProperties": false,
          "type": "object",
          "required": ["role", "generator", "count"],
          "properties": {
            "role": {
              "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
              "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
              "type": "string"
            },
            "generator": {
              "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
              "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
              "type": "string"
            },
            "count": {
              "description": "Inclusive [min, max]",
              "type": "array",
              "items": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "additionalItems": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "npc_careers": {
      "additionalProperties": false,
      "title": "NPC careers",
      "type": "object",
      "required": [
        "roles",
        "start_age",
        "retire_age",
        "group",
        "hire",
        "promotion",
        "job_loss",
        "tiers"
      ],
      "properties": {
        "roles": {
          "minItems": 1,
          "description": "Roles the player holds toward people who get a simulated career",
          "type": "array",
          "items": {
            "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
            "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
            "type": "string"
          }
        },
        "start_age": {
          "minimum": 0,
          "type": "integer"
        },
        "retire_age": {
          "minimum": 0,
          "type": "integer"
        },
        "group": {
          "minLength": 1,
          "description": "Exclusivity group of the jobs NPCs hold",
          "type": "string"
        },
        "retired": {
          "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
          "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "hire": {
          "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
          "description": "Yearly chance an unemployed person with a work history is hired",
          "type": "string"
        },
        "promotion": {
          "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
          "description": "Yearly chance of a promotion once `promotion_years` are served",
          "type": "string"
        },
        "job_loss": {
          "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
          "description": "Yearly chance of losing the job",
          "type": "string"
        },
        "tiers": {
          "description": "Ascending yearly-income thresholds in minor units; the income tier is how many are reached",
          "type": "array",
          "items": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "education": {
          "description": "Flag qualities rolled once when a career starts, in order; `needs` names a flag that must already be true",
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["quality", "chance"],
            "properties": {
              "quality": {
                "minLength": 1,
                "type": "string"
              },
              "chance": {
                "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
                "type": "string"
              },
              "needs": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      }
    },
    "living": {
      "additionalProperties": false,
      "title": "Living costs",
      "type": "object",
      "required": ["default", "housing_share", "home_category"],
      "properties": {
        "default": {
          "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
          "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
          "type": "string"
        },
        "housing_share": {
          "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
          "description": "Share of the living cost an owned home in the current city removes, as a percent literal",
          "type": "string"
        },
        "home_category": {
          "minLength": 1,
          "description": "Item kind category that counts as a home",
          "type": "string"
        },
        "household": {
          "additionalProperties": false,
          "title": "Household costs and guardians",
          "type": "object",
          "required": [
            "dependent_role",
            "dependent_cost",
            "partner_role",
            "partner_share",
            "guardian_roles"
          ],
          "properties": {
            "dependent_role": {
              "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
              "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
              "type": "string"
            },
            "dependent_cost": {
              "minimum": 0,
              "description": "Base yearly cost per dependent living at home in minor units, before the city cost index",
              "type": "integer"
            },
            "partner_role": {
              "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
              "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
              "type": "string"
            },
            "partner_share": {
              "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
              "description": "Share of the standard's cost a partner who moved in pays, as a percent literal",
              "type": "string"
            },
            "guardian_roles": {
              "description": "Roles a guardian is drawn from (an adult relative); the first living one is named in the journal",
              "type": "array",
              "items": {
                "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
                "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "hooks": {
      "additionalProperties": false,
      "title": "Lifecycle hooks (docs/spec/pack-format/hooks.md)",
      "type": "object",
      "properties": {
        "on_birth": {
          "minItems": 1,
          "description": "Effect statements run in order for a lifecycle phase; effect macro calls are allowed",
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "on_age_up_pre": {
          "minItems": 1,
          "description": "Effect statements run in order for a lifecycle phase; effect macro calls are allowed",
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "on_age_up_post": {
          "minItems": 1,
          "description": "Effect statements run in order for a lifecycle phase; effect macro calls are allowed",
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "on_death": {
          "minItems": 1,
          "description": "Effect statements run in order for a lifecycle phase; effect macro calls are allowed",
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "on_milestone": {
          "description": "Effect statements by milestone id",
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "minItems": 1,
              "description": "Effect statements run in order for a lifecycle phase; effect macro calls are allowed",
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
