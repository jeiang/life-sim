{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "People data (list)",
  "type": "array",
  "items": {
    "title": "People data: role or generator",
    "anyOf": [
      {
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "id", "label"],
        "properties": {
          "kind": {
            "const": "role",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "Content id",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "animal": {
            "description": "The people the player holds this role toward are animals: a `scope: person` storylet binds them only when its `target` names an animal role",
            "const": true,
            "type": "boolean"
          }
        }
      },
      {
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "id", "first_names", "age"],
        "properties": {
          "kind": {
            "const": "generator",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "Content id",
            "type": "string"
          },
          "first_names": {
            "description": "A list for every gender, or `{ male, female }` pools (non-binary people draw from both)",
            "anyOf": [
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": ["male", "female"],
                "properties": {
                  "male": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "female": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "gender": {
            "description": "Fixed gender, or draw weights per gender (default male 1, female 1)",
            "anyOf": [
              {
                "anyOf": [
                  {
                    "const": "male",
                    "type": "string"
                  },
                  {
                    "const": "female",
                    "type": "string"
                  },
                  {
                    "const": "nonbinary",
                    "type": "string"
                  }
                ]
              },
              {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "male": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "female": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "nonbinary": {
                    "minimum": 0,
                    "type": "integer"
                  }
                }
              }
            ]
          },
          "last_names": {
            "minItems": 1,
            "description": "Family-name pool; omit it for people with no family name (animals)",
            "type": "array",
            "items": {
              "minLength": 1,
              "type": "string"
            }
          },
          "age": {
            "description": "Inclusive [min, max]",
            "type": "array",
            "items": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "qualities": {
            "description": "Person-scoped qualities set on the spawned person: a fixed value, or an inclusive `[min, max]` range drawn at spawn. Must be `scope: person` qualities visible to this Pack",
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "description": "Inclusive [min, max]",
                    "type": "array",
                    "items": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "integer"
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              }
            }
          },
          "can_carry": {
            "description": "Fixed `can_carry` body flag for every person of this generator; omitted: from the gender (female yes, male no, nonbinary drawn). Independent of gender identity: `set_gender` never changes it",
            "type": "boolean"
          },
          "stats": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "description": "Inclusive [min, max]",
                "type": "array",
                "items": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "additionalItems": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "jobs": {
            "minItems": 1,
            "description": "Static job labels with income tiers; a spawned person gets one at random (no simulated career)",
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["label", "tier"],
              "properties": {
                "label": {
                  "minLength": 1,
                  "type": "string"
                },
                "tier": {
                  "minimum": 0,
                  "description": "Static income tier, 0 up to the number of `npc_careers.tiers`",
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    ]
  }
}
