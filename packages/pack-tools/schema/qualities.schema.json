{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qualities (list)",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "type", "default"],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": {
            "const": "int",
            "type": "string"
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "default": {
            "type": "integer"
          },
          "scope": {
            "description": "`person`: also readable and assignable on a bound person (`person.quality.<id>`); the player's own value is always `quality.<id>`",
            "const": "person",
            "type": "string"
          },
          "format": {
            "description": "`money`: `{quality.<id>}` in text prints as currency (the value is in minor units)",
            "const": "money",
            "type": "string"
          }
        }
      },
      {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "type", "default"],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": {
            "const": "flag",
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "scope": {
            "description": "`person`: also readable and assignable on a bound person (`person.quality.<id>`); the player's own value is always `quality.<id>`",
            "const": "person",
            "type": "string"
          }
        }
      }
    ]
  }
}
