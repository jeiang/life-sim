{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storylets (list)",
  "type": "array",
  "items": {
    "additionalProperties": false,
    "title": "Storylet",
    "type": "object",
    "required": ["id", "trigger"],
    "properties": {
      "id": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "description": "Content id",
        "type": "string"
      },
      "label": {
        "minLength": 1,
        "description": "Actions only: the menu label; default derived from the id",
        "type": "string"
      },
      "icon": {
        "description": "A literal emoji (Twemoji subset) or `gameicons/<author>/<name>`",
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "trigger": {
        "anyOf": [
          {
            "const": "event",
            "type": "string"
          },
          {
            "const": "action",
            "type": "string"
          }
        ]
      },
      "menu": {
        "pattern": "^(occupation|assets|relationships|activities)(/[a-z][a-z0-9_-]*)?$",
        "description": "Actions only: `<top>` or `<top>/<submenu>`",
        "type": "string"
      },
      "scope": {
        "anyOf": [
          {
            "const": "loan",
            "type": "string"
          },
          {
            "const": "person",
            "type": "string"
          }
        ]
      },
      "target": {
        "minItems": 1,
        "description": "`scope: person` only: role ids the bound person must have toward the player",
        "type": "array",
        "items": {
          "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
          "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
          "type": "string"
        }
      },
      "when": {
        "description": "Expression in the Pack expression language (ADR 0004)",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "chance": {
        "description": "Expression in the Pack expression language (ADR 0004)",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "weight": {
        "description": "Expression in the Pack expression language (ADR 0004)",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "once": {
        "type": "boolean"
      },
      "cooldown": {
        "minimum": 1,
        "type": "integer"
      },
      "max_per_life": {
        "minimum": 1,
        "type": "integer"
      },
      "repeatable": {
        "description": "Actions only: may be done many times a year with diminishing returns; excludes `cooldown`",
        "type": "boolean"
      },
      "repeat": {
        "additionalProperties": false,
        "title": "Overrides the manifest's repeat curve for this action",
        "type": "object",
        "properties": {
          "full": {
            "minimum": 0,
            "description": "Uses per year that give the full effect",
            "type": "integer"
          },
          "reduced": {
            "minimum": 0,
            "description": "Uses per year up to which gains are reduced; later uses give none",
            "type": "integer"
          },
          "factor": {
            "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?%$",
            "description": "Share of each gain kept in the reduced range, for example `25%`",
            "type": "string"
          }
        }
      },
      "text": {
        "type": "string"
      },
      "amount": {
        "additionalProperties": false,
        "title": "Amount input (actions only): the player picks money from `min` to `max` in `step`s (default 1); `amount` is bound in choice and outcome `when`, `weight`, effects and text",
        "type": "object",
        "required": ["min", "max"],
        "properties": {
          "min": {
            "description": "Expression in the Pack expression language (ADR 0004)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "max": {
            "description": "Expression in the Pack expression language (ADR 0004)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "step": {
            "description": "Expression in the Pack expression language (ADR 0004)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "mature_text": {
        "description": "Replaces `text` in a life begun with 18+ mode on (chosen at life start, never read live)",
        "type": "string"
      },
      "choices": {
        "type": "array",
        "items": {
          "additionalProperties": false,
          "type": "object",
          "required": ["label"],
          "properties": {
            "label": {
              "minLength": 1,
              "type": "string"
            },
            "mature_label": {
              "minLength": 1,
              "description": "Replaces `label` in a life begun with 18+ mode on",
              "type": "string"
            },
            "when": {
              "description": "Expression in the Pack expression language (ADR 0004)",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "outcomes": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "weight": {
                    "description": "Expression in the Pack expression language (ADR 0004)",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "when": {
                    "description": "Expression in the Pack expression language (ADR 0004)",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "mature_text": {
                    "description": "Replaces `text` in a life begun with 18+ mode on (chosen at life start, never read live)",
                    "type": "string"
                  },
                  "effects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "next": {
                    "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
                    "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "outcomes": {
        "type": "array",
        "items": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "weight": {
              "description": "Expression in the Pack expression language (ADR 0004)",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "when": {
              "description": "Expression in the Pack expression language (ADR 0004)",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "mature_text": {
              "description": "Replaces `text` in a life begun with 18+ mode on (chosen at life start, never read live)",
              "type": "string"
            },
            "effects": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "next": {
              "pattern": "^([a-z][a-z0-9-]*/)?[a-z][a-z0-9_-]*$",
              "description": "Content id reference: `<id>` in the same Pack or `<pack>/<id>`",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
